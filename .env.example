# Copy to .env (or set these as real environment variables / systemd
# EnvironmentFile) before running this backend on a client's own server.
# Every value has a safe local-dev default in application.yaml except the
# two secrets, which MUST be changed before any real deployment.

# --- Database (this client's own Postgres instance) ---
DB_URL=jdbc:postgresql://localhost:5432/tms
DB_USERNAME=tms
DB_PASSWORD=tms

# --- Server ---
SERVER_PORT=8080

# --- JWT (access token signing) ---
# Generate a real per-install secret, e.g.: openssl rand -base64 32
JWT_SECRET=CHANGE_ME_a-real-256-bit-secret-generated-per-install
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=1209600

# --- Mail password encryption-at-rest ---
# Must stay stable once set - rotating it makes existing encrypted SMTP
# passwords unreadable (re-save Mail Configuration after rotating).
MAIL_ENCRYPTION_SECRET=CHANGE_ME_a-real-secret-generated-per-install

# --- Initial super-admin account (seeded once on first boot only) ---
ADMIN_SEED_USERNAME=admin
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=CHANGE_ME_before_first_boot

# --- CORS: the frontend's own origin(s), comma-separated ---
CORS_ALLOWED_ORIGINS=http://localhost:5173

LOG_LEVEL=INFO
